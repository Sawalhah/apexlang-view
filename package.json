{
  "name": "apexlang-view",
  "displayName": "APEXLang View",
  "description": "Structural graph viewer for Oracle APEX's APEXLang export format",
  "version": "0.2.0",
  "publisher": "MohammadSawalhah",
  "author": "Mohammad Sawalhah",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sawalhah/apexlang-view"
  },
  "homepage": "https://github.com/Sawalhah/apexlang-view#readme",
  "bugs": {
    "url": "https://github.com/Sawalhah/apexlang-view/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Visualization", "Other"],
  "activationEvents": [
    "onLanguage:apexlang",
    "workspaceContains:**/*.apx"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "apexlang",
        "extensions": [".apx"],
        "aliases": ["APEXLang"]
      }
    ],
    "commands": [
      {
        "command": "apexlangView.openGraph",
        "title": "APEXLang View: Open Graph View",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "apexlangView.showLogs",
        "title": "APEXLang View: Show Logs"
      },
      {
        "command": "apexlangView.switchFile",
        "title": "APEXLang View: Switch File"
      },
      {
        "command": "apexlangView.openAppMap",
        "title": "APEXLang View: Open App Map"
      },
      {
        "command": "apexlangView.toggleDiff",
        "title": "APEXLang View: Toggle Diff vs HEAD"
      },
      {
        "command": "apexlangView.compareWithCommit",
        "title": "APEXLang View: Compare with Commit…"
      }
    ],
    "configuration": {
      "title": "APEXLang View",
      "properties": {
        "apexlangView.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send anonymous usage and error data (which commands and views are used, coarse parse timings, and error types with this extension's own file and line numbers). Never file names, paths, .apx content, or error messages. Also off whenever VS Code's own `#telemetry.telemetryLevel#` is off. Full list: [telemetry.json](https://github.com/Sawalhah/apexlang-view/blob/main/telemetry.json).",
          "tags": ["telemetry", "usesOnlineServices"]
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "apexlangView.openGraph",
          "when": "resourceExtname == .apx",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "apexlangView.openGraph",
          "when": "resourceExtname == .apx"
        }
      ]
    },
    "keybindings": [
      {
        "command": "apexlangView.openGraph",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "resourceExtname == .apx"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:parser": "node src/test-parser.js",
    "test:corpus": "node src/test-corpus.js"
  }
}
