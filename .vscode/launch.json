{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run APEXLang View Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"]
    },
    {
      "name": "Run APEXLang View Extension (isolated, no other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ]
    }
  ]
}
